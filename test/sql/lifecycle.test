# No remote UI or browser is needed. Runtime dependencies come from DuckDB core,
# exercising the same startup path as an installation from community.
require sqlnb
require json

query T
select json_extract(sqlnb_status(), '$.running');
----
false

query I
select sqlnb_stop();
----
false

statement error
select sqlnb_start(port := -1, open_browser := false);
----
port must be between 0 and 65535

statement error
select sqlnb_start(port := 65536, open_browser := false);
----
port must be between 0 and 65535

statement error
select sqlnb_start(assets := NULL, open_browser := false);
----
sqlnb_start arguments must not be NULL

statement ok
set autoinstall_known_extensions = true;

statement ok
set autoload_known_extensions = true;

# A registered Sidequery repository must not override DuckDB's official Quack.
# This is the public fixture key from DuckDB's extension_repositories_lock test;
# the unreachable repository intentionally cannot serve any extensions.
statement ok
set extension_repository_directory = '{TEST_DIR}/sqlnb-repositories';

statement ok
set allow_extension_repositories = 'allowed';

statement ok
create extension repository sidequery with prefix 'http://127.0.0.1:1' using public key '';

query T
select json_extract(sqlnb_start(assets := 'test/fixtures/ui', notebook_root := '{TEST_DIR}/sqlnb-lifecycle', open_browser := false, mcp := true), '$.running');
----
true

query T
select json_extract(sqlnb_status(), '$.mcp.enabled');
----
true

query IT
select count(*), bool_and(loaded) from duckdb_extensions() where extension_name in ('quack', 'httpfs', 'icu');
----
3	true

query T
select installed_from from duckdb_extensions() where extension_name = 'quack';
----
core

# The capability belongs to the connection that started the server.
statement error other
select sqlnb_status();
----
may only be called from the connection that started SQLNB

statement error other
select sqlnb_stop();
----
may only be called from the connection that started SQLNB

query I
select sqlnb_stop();
----
true

query T
select json_extract(sqlnb_status(), '$.running');
----
false

query I
select sqlnb_stop();
----
false

statement ok
set enable_external_access = false;

statement error
select sqlnb_start(assets := 'test/fixtures/ui', open_browser := false);
----
SQLNB requires enable_external_access=true
